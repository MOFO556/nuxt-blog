{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/prepare-vitest-entry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:replicate": "node scripts/run-litestream.mjs replicate -config litestream.yml",
    "db:restore": "node scripts/run-litestream.mjs restore -if-db-not-exists -if-replica-exists -config litestream.yml",
    "docker:seed": "docker compose --profile seed run --rm seed-db",
    "docker:replicate": "docker compose --profile litestream up litestream",
    "docker:wipe": "docker compose --profile wipe run --rm wipe-db",
    "docker:restore": "docker compose --profile restore run --rm restore-db",
    "docker:app": "docker compose --profile app up --build app",
    "docker:app:skip-tests": "docker compose --profile app build --build-arg SKIP_TESTS=1 && docker compose --profile app up app",
    "test:prepare": "node scripts/prepare-vitest-entry.mjs",
    "test": "pnpm test:prepare && node --disable-warning=DEP0155 ./node_modules/vitest/vitest.mjs run",
    "test:unit": "node --disable-warning=DEP0155 ./node_modules/vitest/vitest.mjs run --project unit",
    "test:nuxt": "pnpm test:prepare && node --disable-warning=DEP0155 ./node_modules/vitest/vitest.mjs run --project nuxt",
    "test:e2e": "node --disable-warning=DEP0155 ./node_modules/vitest/vitest.mjs run --project e2e",
    "test:ci": "pnpm test:prepare && node --disable-warning=DEP0155 ./node_modules/vitest/vitest.mjs run --project unit --project nuxt",
    "test:watch": "pnpm test:prepare && node --disable-warning=DEP0155 ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "^4.11.1",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/critters": "^0.10.1",
    "@pinia/nuxt": "^1.0.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "aws4fetch": "^1.0.20",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "h3": "^1.15.11",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pinia": "^4.0.3",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "sass-loader": "^17.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "ufo": "^1.6.4",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lucide": "^1.2.132",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/test-utils": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.64.1",
    "vitest": "^4.1.11"
  }
}
