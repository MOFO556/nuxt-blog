# Public / non-secret app defaults
NUXT_PUBLIC_API_URL=/api/
NUXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NUXT_WEBAUTHN_RP_ID=localhost
NUXT_WEBAUTHN_RP_NAME=MOFONuxt

# SQLite path (local). In prod use /data/db/stash.db
NUXT_DB_FILE=./.data/db/stash.db

# PORT=3000

APP_JWT_SECRET=
NUXT_SESSION_PASSWORD=

# Litestream to Cloudflare R2 (SQLite replica under db/)
LITESTREAM_BUCKET=mofonuxt
LITESTREAM_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# NuxtHub blob to R2 bucket (images/ prefix)
# Production uses these automatically. Local R2: NUXT_BLOB_DRIVER=s3
S3_BUCKET=mofonuxt
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Assistant (OpenAI-compatible chat + embeddings)
# Local Unsloth/Ollama example:
# AI_BASE_URL=http://127.0.0.1:8000/v1
# AI_API_KEY=local
# AI_MODEL=unsloth-or-hermes-model-name
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=local
# EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding API output size (nomic-embed-text=768; many local embeds=384).
# EMBEDDING_DIMENSIONS=768
# Render / Groq example:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
UNSPLASH_ACCESS_KEY=
# Live web search for drafting posts / current events (tavily | brave)
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
ASSISTANT_GUEST_RPM=10
# Tight image-batch limits on rate-limited APIs (auto from AI_BASE_URL; true|false to force)
# ASSISTANT_SPLIT_TURNS=true
# Max model tool steps per chat turn (default 12 remote / 16 local)
# ASSISTANT_MAX_STEPS=12
